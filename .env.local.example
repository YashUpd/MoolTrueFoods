# MoolTrue Foods — Frontend Environment Variables
# Rename this file to .env.local for development

# 1. Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Razorpay public key (safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_your-key-id

# 3. Backend API URL — Only needed for production (Vite proxy handles dev)
# VITE_API_URL=https://mooltruefoods-backend.onrender.com
