# Frontend Environment Variables
# Copy to .env.local for local development

# Your Google Cloud Console OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API URL (only needed in production - Vite proxy handles dev)
# VITE_API_URL=https://mooltruefoods-backend.onrender.com

# Razorpay Key ID (public key only - safe in frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_your-key-id
